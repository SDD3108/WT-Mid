const STORAGE_KEY = "nextlevel-collections";

export function loadCollections() {
  try {
    const stored = localStorage.getItem(STORAGE_KEY);

    if (!stored) {
      return { want: [], completed: [] };
    }

    const data = JSON.parse(stored);

    if (
      !data ||
      typeof data !== "object" ||
      Array.isArray(data)
    ) {
      return { want: [], completed: [] };
    }

    const validIds = (ids) =>
      Array.isArray(ids)
        ? [...new Set(ids.filter(
            (id) => Number.isInteger(id) && id > 0
          ))]
        : [];

    return {
      want: validIds(data.want),
      completed: validIds(data.completed),
    };
  } catch (error) {
    console.warn("Could not read saved collections:", error);
    return { want: [], completed: [] };
  }
}

export function saveCollections(collections) {
  try {
    localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify({
        want: collections.want.gameIds,
        completed: collections.completed.gameIds,
      })
    );

    return true;
  } catch (error) {
    console.warn("Could not save collections:", error);
    return false;
  }
}
